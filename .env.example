# Vietnamese History GraphRAG - Environment Variables Example
# Copy this file to .env and fill in the actual values

# ═══════════════════════════════════════════════════════════════════════════════
# Neo4j Configuration
# ═══════════════════════════════════════════════════════════════════════════════
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ═══════════════════════════════════════════════════════════════════════════════
# API Keys for AI Services
# ═══════════════════════════════════════════════════════════════════════════════
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# Database Configuration (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════════════════
# User Service Database
USER_DB_URL=postgresql://user:password@localhost:5432/vietnam_history_users

# Chat Service Database
CHAT_DB_URL=postgresql://user:password@localhost:5432/vietnam_history_chat

# ═══════════════════════════════════════════════════════════════════════════════
# JWT Configuration
# ═══════════════════════════════════════════════════════════════════════════════
JWT_SECRET=your_jwt_secret_key_here
