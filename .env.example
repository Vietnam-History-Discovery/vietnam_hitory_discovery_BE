# Vietnamese History GraphRAG - Environment Variables Example
# Copy this file to .env and fill in the actual values

# ═══════════════════════════════════════════════════════════════════════════════
# Neo4j AuraDB Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Note: AuraDB uses neo4j+s:// instead of bolt://
NEO4J_URI=neo4j+s://<your-auradb-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_auradb_password_here

# ═══════════════════════════════════════════════════════════════════════════════
# API Keys for AI Services
# ═══════════════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# Service URLs & CORS Config (For API Gateway)
# ═══════════════════════════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=http://localhost:3000
USER_SERVICE_URL=http://user-service:8081
CHAT_SERVICE_URL=http://chat-service:8082
AI_SERVICE_URL=http://ai-service:8001
ARTICLE_SERVICE_URL=http://article-service:8083

# ═══════════════════════════════════════════════════════════════════════════════
# Firebase Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Path to your Firebase service account JSON key file (for backend)
GOOGLE_APPLICATION_CREDENTIALS=/app/data/firebase-service-account.json

# Firebase Frontend Config
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
